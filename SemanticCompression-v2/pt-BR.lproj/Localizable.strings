"legal.summary.changes.body" = "Por motivos de segurança ou operação, funções podem mudar, publicações podem ser ocultadas, contas podem ser restringidas ou o serviço pode ser suspenso. Alterações importantes serão anunciadas no app ou na página pública.";
"legal.summary.changes.title" = "Alterações e suspensão";
"legal.summary.contact" = "Contato: %@";
"legal.summary.controls.body" = "Você pode mudar o idioma, preparar modelos e limpar o cache no app. Também pode excluir publicações, bloquear pessoas, denunciar conteúdo e excluir sua conta.";
"legal.summary.controls.title" = "Seus controles";
"legal.summary.data.body" = "Tratamos textos de publicações, descrições e ajustes de recriação de fotos, informações de perfil, curtidas, seguidores, comentários, bloqueios, denúncias, dados de login e informações do dispositivo para notificações. As fotos originais das publicações não são enviadas. As fotos de perfil são armazenadas separadamente.";
"legal.summary.data.title" = "Dados que tratamos";
"legal.summary.full_document" = "Ler o documento completo";
"legal.summary.notice" = "Este é um resumo dos pontos principais. Leia o documento completo na página pública.";
"legal.summary.posts.body" = "Descrições de fotos e ajustes de recriação são compartilhados. As imagens são geradas no dispositivo de cada pessoa. Os resultados podem diferir da foto original e variar conforme a pessoa e o dispositivo. A precisão dos resultados não é garantida.";
"legal.summary.posts.title" = "Publicações e recriação";
"legal.summary.prohibited.body" = "São proibidos conteúdo ilegal, violação de direitos, assédio, falsidade de identidade, conteúdo excessivamente sexual ou violento, interrupção do serviço, acesso não autorizado e uso indevido da geração por IA.";
"legal.summary.prohibited.title" = "Condutas proibidas";
"legal.summary.requirements.body" = "Você deve ter pelo menos 18 anos para usar o Mim.\nO uso do app exige concordância com os Termos de uso e a Política de privacidade publicados. Algumas funções, como publicar, curtir, seguir e comentar, exigem login.";
"legal.summary.requirements.title" = "Uso do app";
"legal.summary.storage.body" = "As informações necessárias para publicações e perfis são salvas no servidor e exibidas para outras pessoas. As fotos originais pendentes, os modelos, o cache de imagens recriadas e as configurações são armazenados no seu dispositivo.";
"legal.summary.storage.title" = "Armazenamento e compartilhamento";
"legal.summary.use.body" = "Os dados são usados para exibir publicações, recriar imagens, autenticar contas, enviar notificações, prevenir abusos e responder a solicitações de suporte. A análise de fotos e a geração de imagens por IA são executadas no seu dispositivo.";
"legal.summary.use.title" = "Como usamos os dados";
"legal.summary.version" = "Versão %@";
