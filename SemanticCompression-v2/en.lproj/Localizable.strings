"legal.summary.changes.body" = "For safety or operational reasons, features may change, posts may be hidden, accounts may be restricted, or the service may be suspended. Important changes will be announced in the app or on the public page.";
"legal.summary.changes.title" = "Changes and suspension";
"legal.summary.contact" = "Contact: %@";
"legal.summary.controls.body" = "You can change the display language, prepare models, and clear caches in the app. You can also delete posts, block users, report content, and delete your account.";
"legal.summary.controls.title" = "Your controls";
"legal.summary.data.body" = "We handle post text, photo descriptions and reconstruction settings, profile information, likes, follows, comments, blocks, reports, sign-in information, and device information for notifications. Original post photos are not uploaded. Profile photos are stored separately.";
"legal.summary.data.title" = "Data we handle";
"legal.summary.full_document" = "Read the full document";
"legal.summary.notice" = "This is a guide to the main points. Read the full document on the public page.";
"legal.summary.posts.body" = "Photo descriptions and reconstruction settings are shared. Images are generated on each viewer's device. Results may differ from the original photo and vary by viewer and device environment. Generated results are not guaranteed to be accurate.";
"legal.summary.posts.title" = "Posts and recreation";
"legal.summary.prohibited.body" = "Illegal content, infringement of others' rights, harassment, impersonation, excessively sexual or violent content, service disruption, unauthorized access, and misuse of AI generation are prohibited.";
"legal.summary.prohibited.title" = "Prohibited conduct";
"legal.summary.requirements.body" = "You must be at least 18 years old to use Mim.\nUsing the app requires agreement to the published Terms of Service and Privacy Policy. Some features, including posting, likes, follows, and comments, require sign-in.";
"legal.summary.requirements.title" = "Use of the app";
"legal.summary.storage.body" = "Information needed for posts and profiles is stored on the server and displayed to other users. Queued original photos, models, reconstructed image caches, and settings are stored on your device.";
"legal.summary.storage.title" = "Storage and sharing";
"legal.summary.use.body" = "Data is used to display posts, recreate images, authenticate accounts, deliver notifications, prevent abuse, and respond to support requests. AI photo understanding and image generation run on your device.";
"legal.summary.use.title" = "How we use data";
