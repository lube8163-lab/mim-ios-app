    "content.alert.regenerate.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cached post images will be removed and regenerated with the selected model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán las imágenes en caché visibles y se regenerarán con el modelo seleccionado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在表示中の投稿画像キャッシュを削除して、選択中モデルで再生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 보이는 게시물의 캐시 이미지를 지우고 선택한 모델로 다시 생성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens em cache visíveis serão removidas e regeneradas com o modelo selecionado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前显示的帖子图片缓存将被删除，并使用所选模型重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前顯示的貼文圖片快取將被刪除，並使用所選模型重新生成。"
          }
        }
      }
    },
