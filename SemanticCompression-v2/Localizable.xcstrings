          "stringUnit": {
            "state": "translated",
            "value": "As fotos de perfil são salvas no servidor e exibidas para outras pessoas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人资料照片会保存在服务器上，并向其他用户显示。"
