    "content.alert.logout.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will be signed out of the current account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará la sesión de la cuenta actual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のアカウントからサインアウトします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 계정에서 로그아웃됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você sairá da conta atual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将退出当前账号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你將登出目前帳號。"
          }
        }
      }
    },
