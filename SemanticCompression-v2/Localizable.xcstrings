          }
        }
      }
    },
    "mim.refresh.161f1807a3618616": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の再現にはiOS 27.0.1以降・RAM 8 GB以上の対応端末が必要です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recreating images requires a supported device with iOS 27.0.1 or later and at least 8 GB RAM."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 재생성에는 iOS 27.0.1 이상 및 RAM 8 GB 이상의 지원되는 기기가 필요합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recrear imágenes se necesita un dispositivo compatible con iOS 27.0.1 o posterior y al menos 8 GB de RAM."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recriar imagens requer um dispositivo compatível com iOS 27.0.1 ou posterior e pelo menos 8 GB de RAM."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再生成图片需要搭载iOS 27.0.1或更高版本、至少8 GB内存的兼容设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再生成圖片需要搭載iOS 27.0.1或以上版本、至少8 GB記憶體的相容裝置。"
          }
        }
      }
    },
