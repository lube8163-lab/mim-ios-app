      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿先で再現設定の保存を確認できませんでした。再送せず投稿一覧を確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't confirm that the server saved the recipe. Check your posts before trying again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 재생성 설정이 저장되었는지 확인하지 못했습니다. 다시 보내기 전에 게시물 목록을 확인해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar que el servidor guardó los ajustes de recreación. Revisa tus publicaciones antes de volver a enviarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar se o servidor salvou os ajustes de recriação. Confira suas publicações antes de reenviar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认服务器是否已保存再生成设置，请先查看帖子列表，不要立即重新发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認伺服器是否已儲存再生成設定，請先查看貼文列表，不要立即重新傳送。"
