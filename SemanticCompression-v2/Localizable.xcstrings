          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시물 및 재생성"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicaciones y recreación"
          }
        },
        "pt-BR": {
          "stringUnit": {
