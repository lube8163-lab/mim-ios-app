    "legal.summary.requirements.body": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mimは18歳以上の方が利用できます。\n利用には公開利用規約とプライバシーポリシーへの同意が必要です。投稿、いいね、フォロー、コメントなど一部の機能はログイン後に利用できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You must be at least 18 years old to use Mim.\nUsing the app requires agreement to the published Terms of Service and Privacy Policy. Some features, including posting, likes, follows, and comments, require sign-in."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mim은 만 18세 이상만 이용할 수 있습니다.\n앱을 이용하려면 공개된 이용약관과 개인정보 처리방침에 동의해야 합니다. 게시, 좋아요, 팔로우 및 댓글 등 일부 기능은 로그인 후 사용할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes tener al menos 18 años para usar Mim.\nPara usar la app debes aceptar los Términos del servicio y la Política de privacidad publicados. Algunas funciones, como publicar, dar Me gusta, seguir y comentar, requieren iniciar sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você deve ter pelo menos 18 anos para usar o Mim.\nO uso do app exige concordância com os Termos de uso e a Política de privacidade publicados. Algumas funções, como publicar, curtir, seguir e comentar, exigem login."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您须年满18周岁才能使用Mim。\n使用应用需同意公开的使用条款及隐私政策。发帖、点赞、关注和评论等部分功能需要登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您須年滿18歲才能使用Mim。\n使用App需同意公開的使用條款及隱私權政策。發表貼文、表示喜歡、追蹤和留言等部分功能需要登入。"
          }
        }
      }
    },
    "legal.summary.posts.title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿と再生成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
