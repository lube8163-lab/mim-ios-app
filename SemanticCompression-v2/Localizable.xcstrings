            "value": "Publicações e recriação"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帖子与再生成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼文與再生成"
          }
        }
      }
    },
    "legal.summary.posts.body": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の説明と再生成設定を共有し、画像は見る人の端末で生成します。結果は元の写真と完全には一致せず、見る人や端末の環境によって変わります。生成結果の正確性は保証されません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo descriptions and reconstruction settings are shared. Images are generated on each viewer's device. Results may differ from the original photo and vary by viewer and device environment. Generated results are not guaranteed to be accurate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 설명과 재생성 설정을 공유하며 이미지는 보는 사람의 기기에서 생성됩니다. 결과는 원본 사진과 다를 수 있으며 보는 사람이나 기기 환경에 따라 달라집니다. 생성 결과의 정확성은 보장되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se comparten descripciones y ajustes de recreación. Las imágenes se generan en el dispositivo de cada persona. Los resultados pueden diferir de la foto original y variar según la persona y el dispositivo. No se garantiza la exactitud de los resultados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrições de fotos e ajustes de recriação são compartilhados. As imagens são geradas no dispositivo de cada pessoa. Os resultados podem diferir da foto original e variar conforme a pessoa e o dispositivo. A precisão dos resultados não é garantida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享的是照片描述及再生成设置，图片在每位浏览者的设备上生成。结果可能与原始照片不同，并随浏览者及设备环境而变化。生成结果的准确性不受保证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享的是照片描述及再生成設定，圖片在每位瀏覽者的裝置上生成。結果可能與原始照片不同，並隨瀏覽者及裝置環境而變化。生成結果的準確性不受保證。"
          }
        }
      }
    },
    "legal.summary.prohibited.title": {
      "extractionState": "manual",
      "localizations": {
