    "mim.refresh.d9b1f7dde76c853b": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の処理は投稿後に進みます。アプリを閉じた場合は、開き直すと続きから処理します。"
