    "legal.summary.prohibited.body": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "違法な内容、他者の権利侵害、嫌がらせ、なりすまし、過度に性的または暴力的な内容、サービスの妨害、不正アクセス、AI生成機能の悪用は禁止します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Illegal content, infringement of others' rights, harassment, impersonation, excessively sexual or violent content, service disruption, unauthorized access, and misuse of AI generation are prohibited."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불법 콘텐츠, 타인의 권리 침해, 괴롭힘, 사칭, 지나치게 성적이거나 폭력적인 콘텐츠, 서비스 방해, 무단 접근 및 AI 생성 기능 악용은 금지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se prohíben el contenido ilegal, la vulneración de derechos, el acoso, la suplantación, el contenido excesivamente sexual o violento, la interrupción del servicio, el acceso no autorizado y el uso indebido de la generación con IA."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São proibidos conteúdo ilegal, violação de direitos, assédio, falsidade de identidade, conteúdo excessivamente sexual ou violento, interrupção do serviço, acesso não autorizado e uso indevido da geração por IA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁止违法内容、侵犯他人权利、骚扰、冒充、过度色情或暴力内容、干扰服务、未经授权访问及滥用AI生成功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "禁止違法內容、侵犯他人權利、騷擾、冒充、過度色情或暴力內容、干擾服務、未經授權存取及濫用AI生成功能。"
          }
        }
      }
    },
    "legal.summary.changes.title": {
      "extractionState": "manual",
      "localizations": {
