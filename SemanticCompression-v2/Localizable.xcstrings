    "legal.summary.changes.body": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全性や運用上の理由により、機能の変更、投稿の非表示、アカウント制限、サービスの一時停止を行う場合があります。重要な変更はアプリ内または公開ページで案内します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For safety or operational reasons, features may change, posts may be hidden, accounts may be restricted, or the service may be suspended. Important changes will be announced in the app or on the public page."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전 또는 운영상의 이유로 기능 변경, 게시물 숨김, 계정 제한 또는 서비스 일시 중지가 이루어질 수 있습니다. 중요한 변경은 앱 또는 공개 페이지에서 안내합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por motivos de seguridad u operación, podemos cambiar funciones, ocultar publicaciones, restringir cuentas o suspender el servicio. Los cambios importantes se anunciarán en la app o en la página pública."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por motivos de segurança ou operação, funções podem mudar, publicações podem ser ocultadas, contas podem ser restringidas ou o serviço pode ser suspenso. Alterações importantes serão anunciadas no app ou na página pública."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出于安全或运营原因，可能更改功能、隐藏帖子、限制账户或暂停服务。重要变更会在应用内或公开页面说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於安全或營運原因，可能變更功能、隱藏貼文、限制帳號或暫停服務。重要變更會在App內或公開頁面說明。"
          }
        }
      }
    },
    "mim.refresh.71d755857531ffa5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This content cannot be sent or displayed. Please review it."
          }
