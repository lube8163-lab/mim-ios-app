          }
        }
      }
    },
    "legal.summary.data.body": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿文、写真の説明と再生成設定、プロフィール情報、いいね、フォロー、コメント、ブロック、通報、ログイン情報、通知用の端末情報を扱います。投稿の元写真はアップロードせず、プロフィール画像は別途保存します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We handle post text, photo descriptions and reconstruction settings, profile information, likes, follows, comments, blocks, reports, sign-in information, and device information for notifications. Original post photos are not uploaded. Profile photos are stored separately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시글, 사진 설명과 재생성 설정, 프로필 정보, 좋아요, 팔로우, 댓글, 차단, 신고, 로그인 정보 및 알림용 기기 정보를 처리합니다. 게시물의 원본 사진은 업로드하지 않으며 프로필 사진은 별도로 저장합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratamos textos de publicaciones, descripciones y ajustes de recreación de fotos, datos de perfil, Me gusta, seguimientos, comentarios, bloqueos, denuncias, datos de acceso y datos del dispositivo para notificaciones. Las fotos originales de las publicaciones no se suben. Las fotos de perfil se guardan por separado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratamos textos de publicações, descrições e ajustes de recriação de fotos, informações de perfil, curtidas, seguidores, comentários, bloqueios, denúncias, dados de login e informações do dispositivo para notificações. As fotos originais das publicações não são enviadas. As fotos de perfil são armazenadas separadamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们处理帖子文字、照片描述及再生成设置、个人资料、点赞、关注、评论、屏蔽、举报、登录信息及通知所需的设备信息。帖子的原始照片不会上传，个人资料照片另行保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們處理貼文文字、照片描述及再生成設定、個人檔案、喜歡、追蹤、留言、封鎖、檢舉、登入資訊及通知所需的裝置資訊。貼文的原始照片不會上傳，個人檔案照片另行儲存。"
          }
        }
      }
    },
    "legal.summary.use.title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用目的"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How we use data"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 이용 목적"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo usamos los datos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como usamos os dados"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据用途"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料用途"
          }
        }
      }
    },
    "legal.summary.use.body": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データは投稿の表示、画像の再生成、アカウント認証、通知、不正利用の防止、問い合わせ対応のために使います。写真の理解と画像生成のAI処理は端末内で行います。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data is used to display posts, recreate images, authenticate accounts, deliver notifications, prevent abuse, and respond to support requests. AI photo understanding and image generation run on your device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 게시물 표시, 이미지 재생성, 계정 인증, 알림 전달, 악용 방지 및 문의 대응에 사용됩니다. AI 사진 분석과 이미지 생성은 기기 내에서 이루어집니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos se usan para mostrar publicaciones, recrear imágenes, autenticar cuentas, enviar notificaciones, prevenir abusos y atender consultas. El análisis de fotos y la generación de imágenes con IA se ejecutan en tu dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados são usados para exibir publicações, recriar imagens, autenticar contas, enviar notificações, prevenir abusos e responder a solicitações de suporte. A análise de fotos e a geração de imagens por IA são executadas no seu dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据用于显示帖子、再生成图片、账户认证、发送通知、防止滥用及回复咨询。照片理解和图片生成的AI处理均在设备端进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料用於顯示貼文、再生成圖片、帳號驗證、傳送通知、防止濫用及回覆諮詢。照片理解和圖片生成的AI處理均在裝置端進行。"
          }
        }
      }
    },
    "legal.summary.storage.title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存と共有"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage and sharing"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 및 공유"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenamiento y uso compartido"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenamento e compartilhamento"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存与分享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
