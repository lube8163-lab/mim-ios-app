    "mim.refresh.0283a55b71fd813e": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール画像はサーバーに保存され、ほかのユーザーに表示されます。"
          }
        },
        "en": {
