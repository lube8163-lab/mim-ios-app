    "onboarding.welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images are shared as meaning data and regenerated on each device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes se comparten como datos de significado y se regeneran en cada dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像は意味情報として送られ、端末で再生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지는 의미 정보로 공유되고 각 기기에서 다시 생성됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens são compartilhadas como dados de significado e regeneradas em cada dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像会以语义数据共享，并在各设备上重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖像會以語意資料共享，並在各裝置上重新生成。"
          }
        }
      }
    },
