          }
        }
      }
    },
    "legal.summary.controls.body": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内で表示言語、モデルの準備、キャッシュの消去を操作できます。投稿の削除、ブロック、通報、アカウント削除もアプリ内から行えます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change the display language, prepare models, and clear caches in the app. You can also delete posts, block users, report content, and delete your account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 표시 언어 변경, 모델 준비 및 캐시 삭제를 할 수 있습니다. 게시물 삭제, 사용자 차단, 콘텐츠 신고 및 계정 삭제도 앱에서 할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar el idioma, preparar modelos y borrar la caché en la app. También puedes eliminar publicaciones, bloquear personas, denunciar contenido y eliminar tu cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode mudar o idioma, preparar modelos e limpar o cache no app. Também pode excluir publicações, bloquear pessoas, denunciar conteúdo e excluir sua conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在应用内更改显示语言、准备模型、清除缓存，也可以删除帖子、屏蔽用户、举报内容及删除账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在App內變更顯示語言、準備模型、清除快取，也可以刪除貼文、封鎖使用者、檢舉內容及刪除帳號。"
          }
        }
      }
    },
    "legal.summary.requirements.title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用条件"
          }
