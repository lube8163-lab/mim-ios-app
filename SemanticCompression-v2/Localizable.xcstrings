    "mim.refresh.931a4a41b8d1ff72": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ投稿から、\nそれぞれの景色。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One post.\nA different view for everyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una publicación.\nUna imagen para cada persona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma publicação.\nUma imagem para cada pessoa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 게시물에서,\n각자의 풍경으로."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一条帖子，\n每个人的风景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一則貼文，\n每個人的風景。"
          }
