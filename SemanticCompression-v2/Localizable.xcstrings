    "mim.refresh.877dae035d40a962": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿の保存を確認できませんでした。二重投稿を避けるため、再送せず投稿一覧を確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not confirm whether the post was saved. Check your posts before trying again to avoid duplicates."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시물이 저장되었는지 확인하지 못했습니다. 중복 게시를 피하려면 다시 보내기 전에 게시물 목록을 확인해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar si se guardó la publicación. Revisa tus publicaciones antes de volver a enviarla para evitar duplicados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar se a publicação foi salva. Confira suas publicações antes de reenviar para evitar duplicatas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认帖子是否已保存。为避免重复发布，请先查看帖子列表，再考虑重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認貼文是否已儲存。為避免重複發布，請先查看貼文列表，再考慮重試。"
          }
        }
      }
    },
