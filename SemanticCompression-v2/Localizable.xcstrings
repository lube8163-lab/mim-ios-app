    },
    "mim.refresh.52080682866252b0": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を言葉で届け、見る人の端末で再生成するSNSです。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share photos as words. Each viewer’s device creates its own image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte fotos con palabras. El dispositivo de cada persona crea su propia imagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe fotos com palavras. O dispositivo de cada pessoa cria sua própria imagem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 말로 전하고, 보는 사람의 기기에서 이미지를 다시 만드는 SNS입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用文字传递照片，在每位浏览者的设备上再生成图片的社交应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用文字傳遞照片，在每位瀏覽者的裝置上再生成圖片的社群App。"
          }
        }
      }
    },
