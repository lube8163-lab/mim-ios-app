            "state": "translated",
            "value": "Fallback para geração de imagem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像生成回退"
          }
        },
        "zh-Hant": {
          "stringUnit": {
