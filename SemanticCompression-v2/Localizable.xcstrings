    "mim.refresh.9e39930ae533d601": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿に添付した元の写真は、サーバーに送りません。写真は端末内のAIで処理します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original photos attached to posts are not uploaded. AI processes them on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos originales adjuntas a las publicaciones no se suben al servidor. La IA las procesa en tu dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos originais anexadas às publicações não são enviadas ao servidor. A IA as processa no seu dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시물에 첨부한 원본 사진은 서버에 보내지 않습니다. 사진은 기기 내 AI로 처리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帖子所附的原始照片不会上传到服务器，照片由设备端AI处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼文所附的原始照片不會上傳到伺服器，照片由裝置端AI處理。"
          }
        }
      }
    },
