"legal.summary.changes.body" = "Por motivos de seguridad u operación, podemos cambiar funciones, ocultar publicaciones, restringir cuentas o suspender el servicio. Los cambios importantes se anunciarán en la app o en la página pública.";
"legal.summary.changes.title" = "Cambios y suspensión";
"legal.summary.contact" = "Contacto: %@";
"legal.summary.controls.body" = "Puedes cambiar el idioma, preparar modelos y borrar la caché en la app. También puedes eliminar publicaciones, bloquear personas, denunciar contenido y eliminar tu cuenta.";
"legal.summary.controls.title" = "Tus controles";
"legal.summary.data.body" = "Tratamos textos de publicaciones, descripciones y ajustes de recreación de fotos, datos de perfil, Me gusta, seguimientos, comentarios, bloqueos, denuncias, datos de acceso y datos del dispositivo para notificaciones. Las fotos originales de las publicaciones no se suben. Las fotos de perfil se guardan por separado.";
"legal.summary.data.title" = "Datos que tratamos";
"legal.summary.full_document" = "Leer el documento completo";
"legal.summary.notice" = "Esta es una guía de los puntos principales. Lee el documento completo en la página pública.";
"legal.summary.posts.body" = "Se comparten descripciones y ajustes de recreación. Las imágenes se generan en el dispositivo de cada persona. Los resultados pueden diferir de la foto original y variar según la persona y el dispositivo. No se garantiza la exactitud de los resultados.";
"legal.summary.posts.title" = "Publicaciones y recreación";
"legal.summary.prohibited.body" = "Se prohíben el contenido ilegal, la vulneración de derechos, el acoso, la suplantación, el contenido excesivamente sexual o violento, la interrupción del servicio, el acceso no autorizado y el uso indebido de la generación con IA.";
"legal.summary.prohibited.title" = "Conductas prohibidas";
"legal.summary.requirements.body" = "Debes tener al menos 18 años para usar Mim.\nPara usar la app debes aceptar los Términos del servicio y la Política de privacidad publicados. Algunas funciones, como publicar, dar Me gusta, seguir y comentar, requieren iniciar sesión.";
"legal.summary.requirements.title" = "Uso de la app";
"legal.summary.storage.body" = "La información necesaria para las publicaciones y los perfiles se guarda en el servidor y se muestra a otras personas. Las fotos originales pendientes, los modelos, la caché de imágenes recreadas y los ajustes se guardan en tu dispositivo.";
"legal.summary.storage.title" = "Almacenamiento y uso compartido";
"legal.summary.use.body" = "Los datos se usan para mostrar publicaciones, recrear imágenes, autenticar cuentas, enviar notificaciones, prevenir abusos y atender consultas. El análisis de fotos y la generación de imágenes con IA se ejecutan en tu dispositivo.";
"legal.summary.use.title" = "Cómo usamos los datos";
